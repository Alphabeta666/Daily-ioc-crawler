name: Daily IOC Crawler Pipeline

on:
  schedule:
    # 每天 UTC 02:00 (台灣時間 10:00) 自動執行一次
    - cron: '0 2 * * *'
  workflow_dispatch: # 支援在網頁介面手動點擊執行 (測試用)

permissions:
  contents: write # 賦予 Actions 回寫檔案至儲存庫的權限

jobs:
  run-crawler:
    runs-on: ubuntu-latest

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install requests

      - name: Execute IOC crawler
        run: python crawler.py

      - name: Commit and push updated feeds
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add ioc_feeds/
          # 檢查是否有更動，有更動才進行 commit 與 push
          git diff --quiet && git diff --staged --quiet || (git commit -m "Auto-update IOC feeds: $(date +'%Y-%m-%d %H:%M:%S UTC')" && git push)
